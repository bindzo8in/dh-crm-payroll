// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------- Auth Models -------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum Department {
  SALES
  DEVELOPMENT
  DESIGN
  SEO
  MARKETING
  HR
  OPERATIONS
}

model User {
  id                 String             @id
  name               String
  email              String
  emailVerified      Boolean            @default(false)
  image              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  role               UserRole           @default(STAFF)
  department         Department?
  workMode           WorkMode           @default(OFFICE)
  banned             Boolean?           @default(false)
  banReason          String?
  banExpires         DateTime?
  sessions           Session[]
  accounts           Account[]
  assignedCustomers  Customer[]         @relation("AssignedCustomers")
  createdCustomers   Customer[]         @relation("CreatedCustomers")
  proposalActivities ProposalActivity[]
  proposals          Proposal[]
  createdInvoices    Invoice[]
  invoiceActivities  InvoiceActivity[]
  attendanceRecords  AttendanceRecord[]
  leaveRequests      LeaveRequest[]
  salaryStructure    SalaryStructure?
  salarySlips        SalarySlip[]

  // Payroll Details
  employeeNo         String?
  designation        String?
  bankName           String?
  bankAccountNo      String?
  panNo              String?
  costCenter         String?
  uanNo              String?
  pfNo               String?

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ------------------- Auth Models End -------------------

enum CustomerSource {
  WEBSITE
  GOOGLE
  REFERRAL
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  MANUAL
  OTHER
}

enum CustomerType {
  BUSINESS
  INDIVIDUAL
}

model Customer {
  id String @id @default(cuid())

  customerNumber      Int     @unique @default(autoincrement())
  displayName         String
  companyName         String?
  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  website             String?
  addressLine1        String?
  addressLine2        String?

  billingAddressLine1 String?
  billingAddressLine2 String?

  billingCity       String?
  billingState      String?
  billingCountry    String?
  billingPostalCode String?

  city          String?
  state         String?
  country       String?
  postalCode    String?
  gstNumber     String?
  panNumber     String?
  taxId         String?
  internalNotes String?
  source        CustomerSource?
  customerType  CustomerType    @default(BUSINESS)

  assignedToId String?
  createdById  String?
  assignedTo   User?   @relation("AssignedCustomers", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User?   @relation("CreatedCustomers", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  lastActivityAt   DateTime?
  customerContacts CustomerContact[]
  proposals        Proposal[]
  invoices         Invoice[]

  @@index([assignedToId])
  @@index([createdById])
  @@index([deletedAt])
}

model CustomerContact {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  name        String
  designation String?

  email String?
  phone String?

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([customerId])
}

enum BillingCycle {
  ONE_TIME
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

model Service {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String?

  isActive Boolean @default(true)

  packages ServicePackage[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  proposalServices ProposalService[]

  @@index([isActive])
}

model ServicePackage {
  id String @id @default(cuid())

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  name String

  description String?

  isPopular Boolean @default(false)
  isActive  Boolean @default(true)

  totalPrice    Decimal @default(0) @db.Decimal(12, 2)
  totalPriceUSD Decimal @default(0) @db.Decimal(12, 2)
  sacCode       String? @default("9983") // HSN / SAC Code

  items    ServicePackageItem[]
  features PackageFeature[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  proposalServices     ProposalService[]
  proposalTermPackages ProposalTermPackage[]
  tariffGridPackages   TariffGridPackage[]
  invoiceLineItems     InvoiceLineItem[]

  @@index([serviceId])
  @@index([isActive])
}

model ServicePackageItem {
  id String @id @default(cuid())

  packageId String

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  name        String
  description String?

  quantity Int @default(1)

  unitPrice    Decimal @db.Decimal(12, 2)
  unitPriceUSD Decimal @default(0) @db.Decimal(12, 2)
  sacCode      String? @default("9983")

  unit String

  billingCycle BillingCycle

  sortOrder Int @default(0)

  isOptional Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
}

model PackageFeature {
  id String @id @default(cuid())

  packageId String
  package   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  content   String
  isHeading Boolean @default(false)

  sortOrder Int @default(0)
}

model ProposalTerm {
  id String @id @default(cuid())

  title String

  content Json

  isDefault Boolean @default(false)

  isActive Boolean @default(true)

  packages ProposalTermPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProposalTermPackage {
  termId     String
  packageId  String
  sortOrder  Int     @default(0)
  isRequired Boolean @default(true)

  term ProposalTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([termId, packageId])
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model ProposalTemplate {
  id String @id @default(cuid())

  name String

  coverEnabled       Boolean @default(true)
  coverBackground    Json? // { url: string, publicId: string }
  coverLogo          Json? // { url: string, publicId: string }
  coverWatermark     Json? // { url: string, publicId: string }
  coverFooterEnabled Boolean @default(true)

  primaryColor   String?
  secondaryColor String?
  accentColor    String?

  showServices    Boolean @default(true)
  showContacts    Boolean @default(true)
  showAddress     Boolean @default(true)
  showSocialLinks Boolean @default(false)

  services   Json? // Array of service names
  footerText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals Proposal[]
}

model Proposal {
  id String @id @default(cuid())

  proposalNumber Int @unique @default(autoincrement())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  preparedById String
  preparedBy   User   @relation(fields: [preparedById], references: [id])

  templateId String?
  template   ProposalTemplate? @relation(fields: [templateId], references: [id])

  customerDisplayName String
  customerCompanyName String?
  preparedByName      String

  title String

  status ProposalStatus @default(DRAFT)

  validUntil DateTime?
  acceptedAt DateTime?
  clientSignature Json? // { url: string, publicId: string }

  currency String @default("INR")
  exchangeRate Decimal? @default(83.50) @db.Decimal(10, 4)
  placeOfSupply String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposalBlocks     ProposalBlock[]
  proposalActivities ProposalActivity[]
  proposalServices   ProposalService[]

  subtotal   Decimal @default(0) @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  tax        Decimal @default(0) @db.Decimal(12, 2)
  roundOff   Decimal @default(0) @db.Decimal(12, 2)
  grandTotal Decimal @default(0) @db.Decimal(12, 2)

  bankAccountId String?
  bankAccount   CompanyBankAccount? @relation(fields: [bankAccountId], references: [id])
  invoices      Invoice[]

  @@index([customerId])
  @@index([status])
}

enum ProposalBlockType {
  COVER
  PRICING
  FEATURES
  TERMS
  TIMELINE
  SIGNATURE
  CUSTOM
  PAGE_BREAK
  SECTION
  SERVICE
  PRICING_SUMMARY
}

model ProposalBlock {
  id String @id @default(cuid())

  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  type ProposalBlockType

  sortOrder Int @default(0)

  title String?

  isVisible         Boolean @default(true)
  isLocked          Boolean @default(false)
  isSystemGenerated Boolean @default(false)

  content Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proposalId])
}

model ProposalService {
  id String @id @default(cuid())

  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  // blockId String @unique

  // block ProposalBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  serviceName String

  packageId String?
  package   ServicePackage? @relation(fields: [packageId], references: [id])

  packageName String?

  description String?

  notes String?

  sortOrder Int @default(0)

  items ProposalLineItem[]

  features ProposalFeature[]

  @@index([proposalId])
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

model ProposalLineItem {
  id String @id @default(cuid())

  proposalServiceId String

  proposalService ProposalService @relation(fields: [proposalServiceId], references: [id], onDelete: Cascade)

  packageItemId String?

  name String

  description String?

  quantity Int

  unit String

  unitPrice Decimal @db.Decimal(12, 2)

  total Decimal @db.Decimal(12, 2)

  billingCycle BillingCycle

  sortOrder Int

  isCustom Boolean @default(false)

  createdAt DateTime @default(now())

  discountType DiscountType?

  discountValue Decimal? @db.Decimal(12, 2)

  taxRate Int @default(18)
  sacCode String? @default("9983")

  @@index([proposalServiceId])
}

model ProposalFeature {
  id String @id @default(cuid())

  proposalServiceId String

  proposalService ProposalService @relation(fields: [proposalServiceId], references: [id], onDelete: Cascade)

  content   String
  isHeading Boolean @default(false)

  sortOrder Int @default(0)

  serviceId String?
  packageId String?

  @@index([proposalServiceId])
}

enum ProposalActivityType {
  CREATED
  UPDATED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model ProposalActivity {
  id String @id @default(cuid())

  proposalId String

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  userId String

  user User @relation(fields: [userId], references: [id])

  action ProposalActivityType

  createdAt DateTime @default(now())

  @@index([proposalId])
}

// ------------------- Business Settings Models -------------------

model Company {
  id String @id @default(cuid())

  displayName String
  legalName   String
  tagline     String?
  about       String?

  website        String?
  email          String
  supportEmail   String?
  salesEmail     String?
  phone          String
  secondaryPhone String?

  gstNumber String?
  panNumber String?
  cinNumber String?
  iecCode   String?
  lutNumber String?

  address      String
  city         String
  state        String
  country      String
  postalCode   String?
  googleMapUrl String?

  logo           Json? // { url: string, publicId: string }
  darkLogo       Json?
  favicon        Json?
  signatureImage Json?
  sealImage      Json?

  bankAccounts CompanyBankAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyBankAccount {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  accountName   String
  bankName      String
  branch        String?
  accountNumber String
  ifscCode      String
  swiftCode     String?
  accountType   String?
  upiId         String?
  qrCodeImage   Json? // { url: string, publicId: string }

  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals Proposal[]
  invoices  Invoice[]

  @@index([companyId])
}

// ------------------- Tariff Models -------------------

model TariffGrid {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  packages TariffGridPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TariffGridPackage {
  id String @id @default(cuid())

  tariffGridId String
  tariffGrid   TariffGrid @relation(fields: [tariffGridId], references: [id], onDelete: Cascade)

  packageId String
  package   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  isStartsFrom Boolean @default(false)

  sortOrder Int @default(0)

  @@index([tariffGridId])
  @@index([packageId])
}

// ------------------- Invoice Models -------------------

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id String @id @default(cuid())

  invoiceNumber Int @unique @default(autoincrement())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  proposalId String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  customerDisplayName String
  customerCompanyName String?

  title       String
  notes       String?
  terms       String?
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime      @default(now())
  dueDate     DateTime?

  currency String @default("INR")
  exchangeRate Decimal? @default(83.50) @db.Decimal(10, 4)
  placeOfSupply String?

  subtotal   Decimal @default(0) @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  tax        Decimal @default(0) @db.Decimal(12, 2)
  roundOff   Decimal @default(0) @db.Decimal(12, 2)
  grandTotal Decimal @default(0) @db.Decimal(12, 2)
  amountPaid Decimal @default(0) @db.Decimal(12, 2)

  bankAccountId String?
  bankAccount   CompanyBankAccount? @relation(fields: [bankAccountId], references: [id])

  lineItems  InvoiceLineItem[]
  payments   InvoicePayment[]
  activities InvoiceActivity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([status])
  @@index([deletedAt])
}

model InvoiceLineItem {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  servicePackageId String?
  servicePackage   ServicePackage? @relation(fields: [servicePackageId], references: [id], onDelete: SetNull)

  name        String
  description String?
  quantity    Int          @default(1)
  unit        String       @default("item")
  unitPrice   Decimal      @db.Decimal(12, 2)
  total       Decimal      @db.Decimal(12, 2)
  taxRate     Int          @default(18)
  sacCode     String?      @default("9983")
  billingCycle BillingCycle @default(ONE_TIME)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([servicePackageId])
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CREDIT_CARD
  DEBIT_CARD
  CHEQUE
  CASH
  OTHER
}

model InvoicePayment {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  paymentDate   DateTime      @default(now())
  referenceId   String?
  notes         String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

enum InvoiceActivityType {
  CREATED
  UPDATED
  SENT
  PAYMENT_RECEIVED
  MARKED_PAID
  VOIDED
}

model InvoiceActivity {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  action  InvoiceActivityType
  details String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model ExchangeRateCache {
  id             String   @id @default(cuid())
  baseCurrency   String   @unique
  targetCurrency String   @default("INR")
  rate           Decimal  @db.Decimal(10, 4)
  updatedAt      DateTime @updatedAt
}

model Country {
  id        Int     @id
  name      String
  iso2      String
  iso3      String?
  phonecode String?
  currency  String?
  emoji     String?
  states    State[]

  @@index([name])
  @@index([iso2])
}

model State {
  id          Int     @id
  name        String
  countryId   Int
  countryCode String
  country     Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([name])
  @@index([countryId])
  @@index([countryCode])
}

// ------------------- Attendance System Models -------------------

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  ON_LEAVE
}

enum WorkMode {
  OFFICE
  REMOTE
  HYBRID
}

model AttendanceRecord {
  id                   String               @id @default(cuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                 DateTime             @db.Date
  clockIn              DateTime
  clockOut             DateTime?
  status               AttendanceStatus     @default(PRESENT)
  workMode             WorkMode             @default(OFFICE)
  department           Department?
  ipAddress            String?
  userAgent            String?
  deviceInfo           String?
  latitude             Float?
  longitude            Float?
  locationName         String?
  selfieUrl            String?
  selfiePublicId       String?
  notes                String?
  earlyLeave           Boolean              @default(false)
  lateMinutes          Int                  @default(0)
  earlyLeaveMinutes    Int                  @default(0)
  workMinutes          Int                  @default(0)
  breakMinutes         Int                  @default(0)
  overtimeMinutes      Int                  @default(0)
  regularized          Boolean              @default(false)
  regularizedBy        String?
  regularizationReason String?
  isAutoCheckedOut     Boolean              @default(false)
  isManuallyEdited     Boolean              @default(false)
  distanceFromOffice   Int?
  breaks               AttendanceBreak[]
  auditLogs            AttendanceAuditLog[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
  @@index([department])
  @@map("attendance_record")
}

model AttendanceBreak {
  id                 String           @id @default(cuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  breakStart         DateTime
  breakEnd           DateTime?
  durationMinutes    Int?
  type               String           @default("LUNCH")
  createdAt          DateTime         @default(now())

  @@index([attendanceRecordId])
  @@map("attendance_break")
}


// ------------------- Leave & Holiday Models -------------------

enum LeaveType {
  SICK
  CASUAL
  ANNUAL
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          LeaveType
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  reason        String
  status        LeaveStatus @default(PENDING)
  managerComment String?
  
  // New breakdown calculation tracking fields
  totalDays     Int         @default(0) // Total calendar block size
  netLeaveDays  Int         @default(0) // Actual chargeable work days
  sundayCount   Int         @default(0) // Total Sundays skipped
  holidayCount  Int         @default(0) // Total Public Holidays skipped

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@map("leave_request")
}


model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @db.Date
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@map("holiday")
}

model AttendanceSettings {
  id                      String   @id @default(cuid())
  expectedClockIn         String   @default("09:00") // 24hr format HH:mm
  expectedClockOut        String   @default("18:00") // 24hr format HH:mm
  gracePeriodMinutes      Int      @default(15)
  halfDayThresholdMinutes Int      @default(240) // 4 hours late = Half Day
  maxShiftHoursCap        Int      @default(16) // 16 hours max before auto checkout
  allowOvernightShift     Boolean  @default(true)
  officeLatitude          Float?
  officeLongitude         Float?
  officeRadiusMeters      Int      @default(500)
  enforceOfficeGeofence   Boolean  @default(true)
  updatedAt               DateTime @updatedAt

  @@map("attendance_settings")
}

model AttendanceAuditLog {
  id                 String           @id @default(cuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  userId             String
  editorId           String?
  editorRole         String?
  action             String           // "CREATE", "UPDATE", "REGULARIZE", "AUTO_CHECKOUT"
  oldValues          String?          @db.Text
  newValues          String?          @db.Text
  reason             String?
  createdAt          DateTime         @default(now())

  @@index([attendanceRecordId])
  @@index([userId])
  @@map("attendance_audit_log")
}

// ------------------- Payroll / Salary Models -------------------

model SalaryStructure {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  basicSalary     Decimal  @default(0) @db.Decimal(12, 2)
  hra             Decimal  @default(0) @db.Decimal(12, 2) // House Rent Allowance
  conveyance      Decimal  @default(0) @db.Decimal(12, 2)
  medical         Decimal  @default(0) @db.Decimal(12, 2)
  specialAllowance Decimal @default(0) @db.Decimal(12, 2)
  
  providentFund   Decimal  @default(0) @db.Decimal(12, 2)
  professionalTax Decimal  @default(0) @db.Decimal(12, 2)
  tds             Decimal  @default(0) @db.Decimal(12, 2)
  
  customComponents Json?   // Array of { name: string, type: 'EARNING' | 'DEDUCTION', amount: number }

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("salary_structure")
}

enum SalarySlipStatus {
  DRAFT
  GENERATED
  PAID
}

model SalarySlip {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  month           Int      // 1 to 12
  year            Int
  
  status          SalarySlipStatus @default(DRAFT)
  
  totalDays       Int
  paidDays        Int
  presentDays     Int
  absentDays      Int
  leaveDays       Int
  halfDays        Int
  
  // Breakdown for history/snapshot
  basicSalary     Decimal  @db.Decimal(12, 2)
  hra             Decimal  @db.Decimal(12, 2)
  conveyance      Decimal  @db.Decimal(12, 2)
  medical         Decimal  @db.Decimal(12, 2)
  specialAllowance Decimal @db.Decimal(12, 2)
  
  providentFund   Decimal  @db.Decimal(12, 2)
  professionalTax Decimal  @db.Decimal(12, 2)
  tds             Decimal  @db.Decimal(12, 2)
  
  absentDeduction Decimal  @default(0) @db.Decimal(12, 2)
  halfDayDeduction Decimal @default(0) @db.Decimal(12, 2)
  
  customComponents Json?   // Snapshot of custom components during generation
  
  totalEarnings   Decimal  @db.Decimal(12, 2)
  totalDeductions Decimal  @db.Decimal(12, 2)
  netSalary       Decimal  @db.Decimal(12, 2)
  
  paymentDate     DateTime?
  paymentMethod   String?
  referenceId     String?
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
  @@index([month, year])
  @@index([status])
  @@map("salary_slip")
}

